# Runtime DB URL. Local: same as DIRECT_URL. Vercel: use Transaction pooler (port 6543).
DATABASE_URL=
# Direct connection (migrations, local dev). Required by Prisma when DATABASE_URL is a pooler.
DIRECT_URL=
NEXTAUTH_SECRET=
# Must be exactly one of (no trailing slash):
#   http://localhost:3000
#   https://veya-beta.vercel.app
# Google OAuth / NextAuth callback is ONLY: {NEXTAUTH_URL}/api/auth/callback/google
# Register both full callback URLs in Google Cloud → Web client → Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://veya-beta.vercel.app/api/auth/callback/google
# Vercel Preview URLs are not registered in Google; the app rewrites NEXTAUTH_URL to veya-beta for OAuth on preview.
NEXTAUTH_URL=
OPENAI_API_KEY=
# Optional: model id for POST /api/chat (OpenAI Responses API). Default: gpt-5.4-nano
OPENAI_CHAT_MODEL=
SENDGRID_API_KEY=
# Optional: from address for password reset (e.g. noreply@yourdomain.com). Must be verified in SendGrid.
SENDGRID_FROM_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Same OAuth Web client as Google sign-in. Authorized redirect URIs: only the two URLs above. Enable Gmail API for inbox scan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Plaid (Transactions). Use sandbox keys from Plaid Dashboard.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox

# Vercel Cron: must match the value Vercel sends as Authorization: Bearer … on /api/cron/plaid-sync
# Set in Vercel → Environment Variables as CRON_SECRET (see Vercel Cron job security docs).
CRON_SECRET=

# ── Support & Feedback (Settings form → Google Sheet via Apps Script) ─────────
# Deploy scripts/support-feedback-ingest.gs as a Web app bound to your Sheet; paste the URL here.
# Vercel: add the same variable to Production (and Preview if you want support on preview deploys).
SUPPORT_FEEDBACK_WEBAPP_URL=
# Optional: shared secret — same value as Script property INGEST_SECRET in Apps Script project settings.
SUPPORT_FEEDBACK_WEBAPP_SECRET=
# Optional alias for SUPPORT_FEEDBACK_WEBAPP_URL if you prefer this name:
# GOOGLE_APPS_SCRIPT_SUPPORT_URL=
