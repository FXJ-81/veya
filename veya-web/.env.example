# Runtime DB URL. Local: same as DIRECT_URL. Vercel: use Transaction pooler (port 6543).
DATABASE_URL=
# Direct connection (migrations, local dev). Required by Prisma when DATABASE_URL is a pooler.
DIRECT_URL=
NEXTAUTH_SECRET=
# Local: http://localhost:3000  |  Production (Vercel): https://veya-beta.vercel.app
NEXTAUTH_URL=
OPENAI_API_KEY=
# Optional override for /api/chat (Responses API). Default: gpt-5.4
OPENAI_CHAT_MODEL=
SENDGRID_API_KEY=
# Optional: from address for password reset (e.g. noreply@yourdomain.com). Must be verified in SendGrid.
SENDGRID_FROM_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Same OAuth client as Google sign-in. In Google Cloud, Authorized redirect URIs must include only your NextAuth callback, e.g. http://localhost:3000/api/auth/callback/google and https://veya-beta.vercel.app/api/auth/callback/google. Enable Gmail API for inbox scan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
