# Runtime DB URL. Local: same as DIRECT_URL. Vercel: use Transaction pooler (port 6543).
DATABASE_URL=
# Direct connection (migrations, local dev). Required by Prisma when DATABASE_URL is a pooler.
DIRECT_URL=
NEXTAUTH_SECRET=
# Local: http://localhost:3000  |  Production (Vercel): https://veya-beta.vercel.app
NEXTAUTH_URL=
OPENAI_API_KEY=
SENDGRID_API_KEY=
# Optional: from address for password reset (e.g. noreply@yourdomain.com). Must be verified in SendGrid.
SENDGRID_FROM_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
