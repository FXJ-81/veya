generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  plan          String    @default("free")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  plaidAccounts PlaidAccount[]
  sessions      Session[]
  subscriptions Subscription[]
  aiConversations AIConversation[]
  notifications  Notification[]
  spendingHistory SpendingHistory[]
  userSettings   UserSettings?
  families       FamilyMember[]
  budgets        Budget[]
  plaidSubscriptionCandidates PlaidSubscriptionCandidate[]
  aiMessageUsage AiMessageUsage[]
}

model PlaidAccount {
  id          String    @id @default(cuid())
  userId      String
  accessToken String
  itemId      String    @unique
  bankName    String?
  lastSync    DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlaidSubscriptionCandidate {
  id                    String   @id @default(cuid())
  userId                String
  normalizedMerchantKey String
  matchKeys             String[] @default([])
  name                  String
  merchantName          String
  category              String
  price                 Float
  billingCycle          String
  lastCharged           DateTime
  confidence            String
  status                String   @default("pending")
  firstDetectedAt       DateTime @default(now())
  lastDetectedAt        DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedMerchantKey])
  @@index([userId, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at       Int?
  token_type       String?
  scope            String?
  id_token         String?
  session_state    String?
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  name        String
  category    String
  price       Float
  /// Optional scheduled future price change (keeps `price` until effectiveAt).
  upcomingPrice Float?
  upcomingPriceEffectiveAt DateTime?
  billingCycle String
  startDate   DateTime
  nextRenewal DateTime
  /// Optional last day the plan is active (UTC calendar day); null = ongoing.
  planEndsAt  DateTime?
  status      String   @default("active")
  logoUrl     String?
  notes       String?
  /// manual | gmail
  source      String   @default("manual")
  isShared    Boolean  @default(false)
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Family {
  id         String   @id @default(cuid())
  name       String
  adminId    String
  inviteCode String  @unique
  createdAt  DateTime @default(now())
  members    FamilyMember[]
}

model FamilyMember {
  id       String   @id @default(cuid())
  familyId String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([familyId, userId])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiMessageUsage {
  id        String   @id @default(cuid())
  userId    String
  day       String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
}

model Notification {
  id     String   @id @default(cuid())
  userId String
  type   String
  title  String
  body   String?
  read   Boolean  @default(false)
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SpendingHistory {
  id        String   @id @default(cuid())
  userId    String
  month     Int
  year      Int
  total     Float
  breakdown Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, month, year])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  limit     Float
  period    String   @default("monthly")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  /// UI accent: "brand" (default purple) or "white"
  accentPreference   String   @default("brand")
  notificationPrefs  Json?
  /// Normalized merchant keys the user declined from Plaid scan (do not auto-add or pre-select).
  plaidDeclinedMerchantKeys String[] @default([])
  budgetLimit        Float?
  /// Set after first-login Gmail flow finished (scan, skip, or connect attempt)
  gmailFirstScanCompletedAt DateTime?
  /// After first auto-scan UX completes (confirm modal or skip); when true, never auto-scan again
  hasAutoScanned            Boolean   @default(false)
  lastGmailScanAt           DateTime?
  lastGmailScanFoundCount   Int       @default(0)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
